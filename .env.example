# Copy to .env.local and fill in values before running the app.
#
# Local Supabase (after `pnpm db:start`) prints these values. The local stack
# uses a fixed URL and standard demo keys; the hosted project uses its own.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from `pnpm supabase status`>
SUPABASE_SECRET_KEY=<secret key from `pnpm supabase status`>

# Direct Postgres URL, used only by the authoring scripts (content import/convert).
# `supabase status` prints it as DB_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Set to your deployed origin in production so server-side redirects stay absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Exam mode is under construction. Unset (or 0) hides /exams and its nav entry.
# User changes take precedence over proposed defaults.
NEXT_PUBLIC_EXAM_MODE=0

{
  "name": "quiz-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public,content > src/lib/supabase/database.types.ts",
    "content:import": "tsx scripts/import-questions.ts",
    "content:convert": "tsx scripts/convert-source.ts",
    "admin:grant": "tsx scripts/make-admin.ts",
    "daily:prepare": "tsx scripts/prepare-daily.ts",
    "content:report": "tsx scripts/content-report.ts",
    "test:e2e": "playwright test",
    "guests:cleanup": "tsx scripts/cleanup-guests.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.15.0"
}
